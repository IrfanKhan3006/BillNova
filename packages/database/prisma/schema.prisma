generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN // Registers the business; full access to it
  USER // Created by ADMIN; can only create/print bills & purchases
  SUPER_ADMIN // Platform owner
}

enum TenantPlan {
  FREE
  BASIC
  STARTER
  PRO
  ENTERPRISE
}

model Tenant {
  id   String     @id @default(uuid())
  name String
  slug String     @unique
  plan TenantPlan @default(FREE)

  // Subscription & Plan Limits
  subscriptionStatus String    @default("TRIAL") // "TRIAL", "ACTIVE", "EXPIRED", "SUSPENDED"
  planExpiresAt      DateTime?
  maxFreeInvoices    Int       @default(7)
  planPrice          Float     @default(3000)
  upgradeRequested   Boolean   @default(false)
  maxUsers           Int       @default(2) // team (USER role) accounts allowed
  upgradeRequestedAt DateTime?

  gstin           String?
  stateCode       String?
  address         String?
  phone           String?
  email           String?
  logoUrl         String?
  customHeaderUrl String?

  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  upiId             String?

  invoicePrefix        String  @default("INV")
  invoiceCounter       Int     @default(0)
  purchasePrefix       String  @default("PUR")
  purchaseCounter      Int     @default(0)
  advancePrefix        String  @default("ADV")
  advanceCounter       Int     @default(0)
  quotationPrefix      String  @default("QT")
  quotationCounter     Int     @default(0)
  salesOrderPrefix     String  @default("SO")
  salesOrderCounter    Int     @default(0)
  purchaseOrderPrefix  String  @default("PO")
  purchaseOrderCounter Int     @default(0)
  dueDays              Int     @default(30)
  invoiceTemplate      String  @default("CLASSIC")
  defaultNotes         String? // Printed at the end of every new bill

  // WhatsApp bill sharing
  googleReviewUrl     String? // Google review link used in the WhatsApp bill message
  whatsappTemplate    String? // Custom WhatsApp message template (placeholders: {customer} {amount} {billLink} {review} {phone} {business} {invoiceNo})
  appointmentTemplate String? // WhatsApp appointment confirmation template (placeholders: {customer} {date} {time} {service} {staff} {phone} {business})

  // Gating Toggles
  billingEnabled        Boolean @default(true)
  productsEnabled       Boolean @default(true)
  paymentsEnabled       Boolean @default(true)
  reportsEnabled        Boolean @default(true)
  purchasesEnabled      Boolean @default(true)
  quotationsEnabled     Boolean @default(false)
  salesOrdersEnabled    Boolean @default(false)
  purchaseOrdersEnabled Boolean @default(false)

  // Business Type & Inventory Setting
  businessType   String  @default("RETAIL") // "RETAIL", "SERVICES_TRAVEL", "WHOLESALE", "MANUFACTURING", "SERVICES_GENERAL"
  trackInventory Boolean @default(true)
  theme          String  @default("LIGHT") // "LIGHT", "DARK"

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users             User[]
  refreshTokens     RefreshToken[]
  customers         Customer[]
  vendors           Vendor[]
  productCategories ProductCategory[]
  products          Product[]
  invoices          Invoice[]
  payments          Payment[]
  purchaseInvoices  PurchaseInvoice[]
  purchasePayments  PurchasePayment[]
  enquiries         Enquiry[]
  appointments      Appointment[]
  quotations        Quotation[]
  salesOrders       SalesOrder[]
  purchaseOrders    PurchaseOrder[]

  @@map("tenants")
}

// Sales enquiries raised from the app (e.g. "need more users" on the plan modal)
model Enquiry {
  id          String   @id @default(uuid())
  tenantId    String
  type        String   @default("EXTRA_USERS")
  name        String
  phone       String
  email       String?
  usersNeeded String?
  message     String?
  status      String   @default("NEW") // NEW | DONE
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([status, createdAt])
  @@map("enquiries")
}

model User {
  id           String  @id @default(uuid())
  tenantId     String?
  email        String
  name         String  @default("")
  passwordHash String
  role         Role    @default(USER)
  isActive     Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  refreshTokens RefreshToken[]

  @@unique([tenantId, email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String?
  tokenHash String
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@map("refresh_tokens")
}

model Customer {
  id                 String    @id @default(uuid())
  tenantId           String
  name               String
  email              String?
  phone              String?
  address            String?
  gstin              String?
  outstandingBalance Float     @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  invoices     Invoice[]
  payments     Payment[]
  appointments Appointment[]
  quotations   Quotation[]
  salesOrders  SalesOrder[]

  @@map("customers")
}

model ProductCategory {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@map("product_categories")
}

model Product {
  id            String    @id @default(uuid())
  tenantId      String
  categoryId    String?
  name          String
  sku           String?
  barcode       String?
  hsnCode       String?
  description   String?
  salesPrice    Float     @default(0)
  purchasePrice Float     @default(0)
  taxRate       Float     @default(0) // Tax percentage (e.g. 18 for 18% GST)
  unit          String    @default("PCS") // PCS, BOX, KG, LTR etc.
  stock         Int       @default(0)
  isService     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  category             ProductCategory?      @relation(fields: [categoryId], references: [id])
  invoiceItems         InvoiceItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  quotationItems       QuotationItem[]
  salesOrderItems      SalesOrderItem[]
  purchaseOrderItems   PurchaseOrderItem[]

  @@map("products")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  VOID
}

model Invoice {
  id             String        @id @default(uuid())
  tenantId       String
  customerId     String
  invoiceNumber  String
  date           DateTime      @default(now())
  dueDate        DateTime
  createdById    String? // User who created the bill (for per-user analytics)
  status         InvoiceStatus @default(DRAFT)
  discountAmount Float         @default(0)
  taxAmount      Float         @default(0)
  subTotal       Float         @default(0)
  totalAmount    Float         @default(0)
  amountPaid     Float         @default(0)
  amountDue      Float         @default(0)
  notes          String?
  shareToken     String?       @unique // public bill link token (/bill?s=<token>)

  // Advance Bill tracking & Auto-conversion
  isAdvance                  Boolean @default(false)
  advanceConverted           Boolean @default(false)
  convertedInvoiceId         String?
  convertedFromAdvanceNumber String?

  // e-Invoice fields
  irn     String?
  ackNo   String?
  ackDate DateTime?

  // Consignee details
  consigneeName    String?
  consigneeAddress String?
  consigneeGstin   String?
  consigneeState   String?

  // Dispatch details
  deliveryNote      String?
  deliveryNoteDate  DateTime?
  paymentTerms      String?
  supplierRef       String?
  otherReferences   String?
  buyersOrderNo     String?
  buyersOrderDate   DateTime?
  despatchDocNo     String?
  despatchedThrough String?
  destination       String?
  termsOfDelivery   String?
  vehicleNumber     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  customer Customer      @relation(fields: [customerId], references: [id])
  items    InvoiceItem[]
  payments Payment[]

  @@unique([tenantId, invoiceNumber])
  @@map("invoices")
}

model InvoiceItem {
  id             String  @id @default(uuid())
  invoiceId      String
  productId      String?
  name           String
  qty            Int     @default(1)
  price          Float   @default(0)
  taxRate        Float   @default(0)
  taxAmount      Float   @default(0)
  discountRate   Float   @default(0)
  discountAmount Float   @default(0)
  total          Float   @default(0)
  hsnCode        String?

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@map("invoice_items")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  UPI
  OTHER
}

model Payment {
  id          String        @id @default(uuid())
  tenantId    String
  customerId  String
  invoiceId   String?
  amount      Float
  date        DateTime      @default(now())
  method      PaymentMethod @default(CASH)
  referenceNo String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  invoice  Invoice? @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Purchase Invoices & Vendors
// ─────────────────────────────────────────────────────────────────────────────

enum PurchaseStatus {
  DRAFT
  RECEIVED
  PAID
  PARTIALLY_PAID
  CANCELLED
}

model Vendor {
  id                 String    @id @default(uuid())
  tenantId           String
  name               String
  email              String?
  phone              String?
  address            String?
  gstin              String?
  stateCode          String?
  outstandingBalance Float     @default(0)
  bankAccountName    String?
  bankAccountNumber  String?
  bankIfsc           String?
  upiId              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  purchaseInvoices PurchaseInvoice[]
  payments         PurchasePayment[]
  purchaseOrders   PurchaseOrder[]

  @@map("vendors")
}

model PurchaseInvoice {
  id             String         @id @default(uuid())
  tenantId       String
  vendorId       String
  purchaseNumber String
  billNumber     String?
  date           DateTime       @default(now())
  createdById    String? // User who recorded the purchase
  dueDate        DateTime?
  status         PurchaseStatus @default(RECEIVED)
  subTotal       Float          @default(0)
  taxAmount      Float          @default(0)
  discountAmount Float          @default(0)
  totalAmount    Float          @default(0)
  amountPaid     Float          @default(0)
  amountDue      Float          @default(0)
  notes          String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant   Tenant                @relation(fields: [tenantId], references: [id])
  vendor   Vendor                @relation(fields: [vendorId], references: [id])
  items    PurchaseInvoiceItem[]
  payments PurchasePayment[]

  @@unique([tenantId, purchaseNumber])
  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id                String  @id @default(uuid())
  purchaseInvoiceId String
  productId         String?
  name              String
  qty               Int     @default(1)
  price             Float   @default(0)
  taxRate           Float   @default(0)
  taxAmount         Float   @default(0)
  discountRate      Float   @default(0)
  discountAmount    Float   @default(0)
  total             Float   @default(0)
  hsnCode           String?

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  product         Product?        @relation(fields: [productId], references: [id])

  @@map("purchase_invoice_items")
}

model PurchasePayment {
  id                String        @id @default(uuid())
  tenantId          String
  vendorId          String
  purchaseInvoiceId String?
  amount            Float
  date              DateTime      @default(now())
  method            PaymentMethod @default(BANK_TRANSFER)
  referenceNo       String?
  notes             String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  vendor          Vendor           @relation(fields: [vendorId], references: [id])
  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])

  @@map("purchase_payments")
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// A manually booked appointment (salon-style businesses).
model Appointment {
  id           String            @id @default(uuid())
  tenantId     String
  customerId   String
  service      String
  staffName    String?
  /// Date and start time of the appointment, stored together.
  startsAt     DateTime
  /// How long it is expected to take, used for the calendar entry's end time.
  durationMins Int               @default(60)
  status       AppointmentStatus @default(SCHEDULED)
  notes        String?
  createdById  String?
  /// Set once a bill has been raised from this appointment.
  invoiceId    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([tenantId, startsAt])
  @@map("appointments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Sales pipeline: Quotation → Sales Order → Invoice
// Purchase pipeline: Purchase Order → Purchase Invoice
//
// These are standalone documents. They never mutate Invoice/PurchaseInvoice;
// converting one copies its data forward and records the source id, so the
// existing billing, purchase, reporting and dashboard code is untouched.
// ─────────────────────────────────────────────────────────────────────────────

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_DELIVERED
  DELIVERED
  INVOICED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model Quotation {
  id              String          @id @default(uuid())
  tenantId        String
  customerId      String
  quotationNumber String
  date            DateTime        @default(now())
  validUntil      DateTime?
  createdById     String?
  status          QuotationStatus @default(DRAFT)
  subTotal        Float           @default(0)
  taxAmount       Float           @default(0)
  discountAmount  Float           @default(0)
  totalAmount     Float           @default(0)
  paymentTerms    String?
  deliveryTerms   String?
  notes           String?

  // Forward link once the customer accepts and it becomes an order
  convertedSalesOrderId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  customer    Customer        @relation(fields: [customerId], references: [id])
  items       QuotationItem[]
  salesOrders SalesOrder[]

  @@unique([tenantId, quotationNumber])
  @@index([tenantId, date])
  @@map("quotations")
}

model QuotationItem {
  id             String  @id @default(uuid())
  quotationId    String
  productId      String?
  name           String
  description    String?
  qty            Int     @default(1)
  price          Float   @default(0)
  taxRate        Float   @default(0)
  taxAmount      Float   @default(0)
  discountRate   Float   @default(0)
  discountAmount Float   @default(0)
  total          Float   @default(0)
  hsnCode        String?

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id])

  @@map("quotation_items")
}

model SalesOrder {
  id                   String           @id @default(uuid())
  tenantId             String
  customerId           String
  quotationId          String?
  salesOrderNumber     String
  date                 DateTime         @default(now())
  expectedDeliveryDate DateTime?
  createdById          String?
  status               SalesOrderStatus @default(DRAFT)
  subTotal             Float            @default(0)
  taxAmount            Float            @default(0)
  discountAmount       Float            @default(0)
  totalAmount          Float            @default(0)
  paymentTerms         String?
  deliveryTerms        String?
  notes                String?

  // Ship-to party (the "ship-to" of the PDF; may differ from the customer)
  shipToName    String?
  shipToAddress String?
  shipToGstin   String?
  shipToState   String?

  // Forward link once billed
  convertedInvoiceId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  customer  Customer         @relation(fields: [customerId], references: [id])
  quotation Quotation?       @relation(fields: [quotationId], references: [id])
  items     SalesOrderItem[]

  @@unique([tenantId, salesOrderNumber])
  @@index([tenantId, date])
  @@map("sales_orders")
}

model SalesOrderItem {
  id             String  @id @default(uuid())
  salesOrderId   String
  productId      String?
  name           String
  description    String?
  qty            Int     @default(1)
  deliveredQty   Int     @default(0)
  price          Float   @default(0)
  taxRate        Float   @default(0)
  taxAmount      Float   @default(0)
  discountRate   Float   @default(0)
  discountAmount Float   @default(0)
  total          Float   @default(0)
  hsnCode        String?

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product?   @relation(fields: [productId], references: [id])

  @@map("sales_order_items")
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  tenantId             String
  vendorId             String
  purchaseOrderNumber  String
  date                 DateTime            @default(now())
  expectedDeliveryDate DateTime?
  createdById          String?
  status               PurchaseOrderStatus @default(DRAFT)
  subTotal             Float               @default(0)
  taxAmount            Float               @default(0)
  discountAmount       Float               @default(0)
  totalAmount          Float               @default(0)
  paymentTerms         String?
  deliveryAddress      String?
  termsAndConditions   String?
  notes                String?

  // Step 5 of the PDF: review and approve before sending to the supplier
  approvedByName String?
  approvedAt     DateTime?

  // Forward link once the supplier bill is recorded
  convertedPurchaseInvoiceId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant              @relation(fields: [tenantId], references: [id])
  vendor Vendor              @relation(fields: [vendorId], references: [id])
  items  PurchaseOrderItem[]

  @@unique([tenantId, purchaseOrderNumber])
  @@index([tenantId, date])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid())
  purchaseOrderId String
  productId       String?
  name            String
  description     String?
  qty             Int     @default(1)
  receivedQty     Int     @default(0)
  price           Float   @default(0)
  taxRate         Float   @default(0)
  taxAmount       Float   @default(0)
  discountRate    Float   @default(0)
  discountAmount  Float   @default(0)
  total           Float   @default(0)
  hsnCode         String?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id])

  @@map("purchase_order_items")
}
